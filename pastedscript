				end
			end

			local center = camera.ViewportSize / 2
			local targetWorld = Flags["Crosshair_At_Target"].value and GetClosestTargetWorld() or nil

			if targetWorld then
				local sp, onScreen = camera:WorldToViewportPoint(targetWorld)
				local raw = Vector2.new(sp.X, sp.Y)

				if onScreen or not Flags["Crosshair_OutOfView"].value then
					Visuals.crosshair.targetScreenPosition = raw
				else
					local dir = (raw - center).Unit
					local radius = math.min(center.X, center.Y) - Flags["Crosshair_Edge_Offset"].value
					Visuals.crosshair.targetScreenPosition = center + dir * radius
				end
			else
				Visuals.crosshair.targetScreenPosition = center
			end

			Visuals.crosshair.screenPosition =
