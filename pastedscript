				or Flags["Crosshair_Rotation_Speed"].value

			local scale = animated
				and (Flags["Minimum_Length"].value + (Flags["Maximum_Length"].value - Flags["Minimum_Length"].value) * t)
				or 1

			local width = Flags["Crosshair_Width"].value * scale
			local length = Flags["Crosshair_Length"].value * scale
			local widthGap = Flags["Crosshair_Width_Gap"].value * scale
			local lengthGap = Flags["Crosshair_Length_Gap"].value * scale

			Visuals.crosshair.currentaddedrotation += speed * deltaTime
